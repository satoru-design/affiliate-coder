# 実際の値はこのファイルに書かず、Vercel の Environment Variables か
# ローカルの .env.local に設定する。.env* は .gitignore 済み。

# 楽天ウェブサービスの資格情報
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=

# 管理画面のログインパスワード。12文字以上。
# 未設定または12文字未満の場合、ログインは常に失敗する。
APP_PASSWORD=

# セッション Cookie の署名鍵。32文字以上。
# 生成例: openssl rand -base64 32
# 未設定または32文字未満の場合、ログインは常に失敗する。
SESSION_SECRET=
